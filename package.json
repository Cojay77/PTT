{
  "name": "ptt",
  "private": true,
  "version": "1.0.0",
  "description": "Project Tracking Tool — Local-First Project Pilot Workspace",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "cross-env NODE_ENV=development electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on tcp:5174 && cross-env NODE_ENV=development electron electron/main.cjs\"",
    "electron:build": "tsc -b && vite build && electron-builder --win",
    "electron:portable": "tsc -b && vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.ptt.projectpilot",
    "productName": "PTT",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "fileAssociations": [
        {
          "ext": "ptt",
          "name": "PTT Project File",
          "description": "PTT Project File"
        },
        {
          "ext": "db",
          "name": "SQLite Database",
          "description": "PTT Database"
        }
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.2",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
